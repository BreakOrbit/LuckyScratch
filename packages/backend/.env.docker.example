# Copy this file to `.env.docker` and adjust the values before starting:
#   docker compose --env-file .env.docker up -d
#
# External PostgreSQL:
# - If PostgreSQL runs on the Docker host, keep `host.docker.internal`.
# - If PostgreSQL runs on another machine, replace the host/user/password/db name below.
DATABASE_URL=postgres://postgres:postgres@host.docker.internal:5432/lucky_scratch?sslmode=disable
# DATABASE_URL=postgres://app_user:strong-password@db.example.com:5432/lucky_scratch?sslmode=require

# EVM RPC
RPC_URL=http://host.docker.internal:8545
CHAIN_ID=31337
CHAIN_NAME=hardhat
#
# Sepolia minimum:
# RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your-key
# CHAIN_ID=11155111
# CHAIN_NAME=sepolia

# API
API_PORT=8080
API_PUBLIC_BASE_URL=http://localhost:8080
#
# When deployed behind a public domain or reverse proxy, set the external base URL:
# API_PUBLIC_BASE_URL=https://api.example.com

# Startup behavior
AUTO_MIGRATE=true
AUTO_IMPORT_DEPLOYMENTS=true
APP_ENV=production
LOG_LEVEL=info

# Optional admin auth
ADMIN_TOKEN=replace-me

# Optional job / reveal tuning
REVEAL_SUBMIT_TIMEOUT=2m
JOB_LOCK_TIMEOUT=5m

# Optional IPFS config
# Leave IPFS_PROVIDER empty if you do not need image / metadata uploads from this backend.
IPFS_PROVIDER=pinata
IPFS_GATEWAY_BASE_URL=https://gateway.pinata.cloud/ipfs
IPFS_PINATA_JWT=
IPFS_PINATA_API_BASE_URL=https://api.pinata.cloud
IPFS_KUBO_API_URL=http://host.docker.internal:5001
IPFS_UPLOAD_MAX_BYTES=10485760
POOL_DRAFT_TTL=24h

# Optional Zama config
# Local hardhat:
# - Keep these empty. The backend stays in frontend-local-proof mode.
#
# Sepolia minimum:
# - Set CHAIN_ID=11155111 and CHAIN_NAME=sepolia above.
# - The backend will automatically use the official Zama Sepolia relayer and protocol contract defaults.
# - Official Sepolia testnet relayer access does not require ZAMA_API_KEY.
#
# Override these only if you are not using the official Sepolia defaults.
ZAMA_MODE=
ZAMA_RELAYER_URL=
ZAMA_API_KEY=
# ZAMA_GATEWAY_CHAIN_ID=
# ZAMA_FHEVM_EXECUTOR_CONTRACT_ADDRESS=
# ZAMA_ACL_CONTRACT_ADDRESS=
# ZAMA_HCU_CONTRACT_ADDRESS=
# ZAMA_KMS_VERIFIER_CONTRACT_ADDRESS=
# ZAMA_INPUT_VERIFIER_CONTRACT_ADDRESS=
# ZAMA_DECRYPTION_ADDRESS=
# ZAMA_INPUT_VERIFICATION_ADDRESS=
# ZAMA_USER_DECRYPT_DURATION_DAYS=1
# ZAMA_MAX_USER_DECRYPT_BITS=2048
ZAMA_HTTP_TIMEOUT=30s
